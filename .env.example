# NeuroFlow Configuration Example
# Скопируйте этот файл в .env и заполните своими данными

# Telegram Bot Configuration
BOT_TOKEN=your_bot_token_here
ADMIN_USER_ID=your_telegram_id_here

# Groq AI API Keys (получите на https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here
GROQ_API_KEY_2=your_groq_api_key_2_here
GROQ_API_KEY_3=your_groq_api_key_3_here
GROQ_API_KEY_4=your_groq_api_key_4_here
GROQ_API_KEY_5=your_groq_api_key_5_here
GROQ_API_KEY_6=your_groq_api_key_6_here
GROQ_API_KEY_7=your_groq_api_key_7_here

# WebApp Configuration
WEBAPP_URL=http://your_server_ip

# Database Configuration
DATABASE_URL=sqlite:///bot_database.db
REDIS_URL=redis://localhost:6379/0
REDIS_POOL_MAX_CONNECTIONS=50
REDIS_CACHE_TTL=3600

# PostgreSQL Database (опционально)
DATABASE_POOL_MIN_SIZE=10
DATABASE_POOL_MAX_SIZE=50

# Payment Systems (опционально)
AAIO_API_KEY=your_aaio_api_key_here
AAIO_SHOP_ID=your_aaio_shop_id_here
AAIO_SECRET_KEY=your_aaio_secret_key_here
CRYPTO_BOT_TOKEN=your_crypto_bot_token_here

# Image Generation APIs (опционально)
HUGGINGFACE_API_KEY=your_huggingface_api_key_here
STABLE_DIFFUSION_API_KEY=your_stable_diffusion_api_key_here
REPLICATE_API_KEY=your_replicate_api_key_here